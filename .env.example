APP_NAME=Quantro
APP_NAME=GridsGold
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Central app hosts. Tenant domains/subdomains should NOT be listed here.
CENTRAL_DOMAINS=quantro.test,localhost,127.0.0.1

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Central (SaaS) database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quantro_central
DB_USERNAME=root
DB_PASSWORD=
DB_COLLATION=utf8mb4_unicode_ci

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=public
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Central (SaaS) database — holds tenants, domains, plans, billing.
DB_CONNECTION=central
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=central
DB_USERNAME=root
DB_PASSWORD=

# Base name used when provisioning each tenant's own database
# (stancl/tenancy prefixes/suffixes this per tenant).
DB_TENANT_DATABASE=tenant

# Hosts treated as the central (non-tenant) app. Any other host is resolved
# as a tenant subdomain/custom domain. Comma-separated, no spaces.
CENTRAL_DOMAINS=localhost,127.0.0.1

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# AWS / S3 (only needed if FILESYSTEM_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# Redis (only needed if CACHE_DRIVER/QUEUE_CONNECTION/SESSION_DRIVER=redis)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pusher (only needed if BROADCAST_DRIVER=pusher)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# Laravel Passport (API auth) — generate with `php artisan passport:install`,
# then paste the printed client ID/secret here.
PASSPORT_PERSONAL_ACCESS_CLIENT_ID=
PASSPORT_PERSONAL_ACCESS_CLIENT_SECRET=

# Stripe (billing/checkout)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

FLUTTERWAVE_REDIRECT_URL=

# Flutterwave (checkout redirect)
FLUTTERWAVE_REDIRECT_URL=

# WooCommerce sync (only needed for tenants with the woocommerce feature)
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Mailgun / Postmark (alternate mail transports)
MAILGUN_DOMAIN=
MAILGUN_SECRET=
MAILGUN_ENDPOINT=api.mailgun.net
POSTMARK_TOKEN=

NEXMO_KEY=
NEXMO_SECRET=

# Nexmo/Vonage SMS
NEXMO_KEY=
NEXMO_SECRET=

# Google Calendar integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

TENANCY_TRIAL_DAYS=14
TENANCY_EXPIRY_WARNING_DAYS=7

ACCOUNTING_V2_ENABLED=true
ACCOUNTING_V2_AUTO_JOURNALS=false
# Tenancy defaults
TENANCY_TRIAL_DAYS=14
TENANCY_EXPIRY_WARNING_DAYS=7

# AccountingV2 module
ACCOUNTING_V2_ENABLED=true
ACCOUNTING_V2_AUTO_JOURNALS=false
